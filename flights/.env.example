# Copy to flights/.env and fill in what you have. Everything is optional — with no keys at all,
# Skylark runs on a keyword parser and a labelled synthetic fare provider.
#
# Exported environment variables always win over this file.

# AI search. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Real fares. https://developers.amadeus.com — create an app, copy the key and secret.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# "test" is the free sandbox: a real API over a limited cached dataset, so major city pairs work
# and obscure routes come back empty. Switch to "production" for live inventory.
AMADEUS_ENV=test

# PORT=5174
